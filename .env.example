# ==============================================================================
# Variables de entorno públicas para el cliente Vite + Supabase (SB-Finance)
# ==============================================================================
# Copiá este archivo como `.env` en la raíz del proyecto y completá los valores
# de tu proyecto en Supabase.
# IMPORTANTE: Nunca expongas `SUPABASE_SERVICE_ROLE_KEY` ni secretos privados
# en el frontend (variables con prefijo `VITE_`).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TELEGRAM_BOT_USERNAME=

# ------------------------------------------------------------------------------
# Secretos de servidor para Supabase Edge Functions (configurar vía `supabase secrets set`)
# No deben agregarse al `.env` del cliente ni prefijarse con `VITE_`:
#   - TELEGRAM_BOT_TOKEN=
#   - TELEGRAM_WEBHOOK_SECRET=
#   - GEMINI_API_KEY=
#   - GEMINI_MODEL=gemini-3.8-flash
#   - GEMINI_FALLBACK_MODEL=gemini-2.5-flash
#   - CRON_INTERNAL_SECRET=
#   - ALLOWED_ORIGINS=
#
# Secretos opcionales para Vercel Functions (`/api/keep-alive`):
#   - SUPABASE_URL=
#   - SUPABASE_ANON_KEY=
#   - CRON_SECRET=
# ------------------------------------------------------------------------------
